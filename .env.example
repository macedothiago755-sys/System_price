# ──────────────────────────────────────────────
# THIAGO OS — Environment Variables
# Copy this file to `.env.local` and fill in values
# ──────────────────────────────────────────────

# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key (NEVER expose to the browser). Used by trusted server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n (future automations) — base URL of your n8n instance webhook
N8N_WEBHOOK_URL=

# Polar Flow (future health integration) — placeholder
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
