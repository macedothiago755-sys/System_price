# ──────────────────────────────────────────────
# THIAGO OS — Environment Variables
# Copy this file to `.env.local` and fill in values
# ──────────────────────────────────────────────

# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key (NEVER expose to the browser). Used by trusted server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── IA: escolha UM provedor ──────────────────────────────
# Opção A — Anthropic Claude (pago) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Opção B — Google Gemini (tem nível GRATUITO) — https://aistudio.google.com/app/apikey
# Se ANTHROPIC_API_KEY estiver vazia e esta preenchida, o app usa o Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n (future automations) — base URL of your n8n instance webhook
N8N_WEBHOOK_URL=

# Polar Flow (future health integration) — placeholder
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
